        /* Font families */
        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        code, pre, .font-mono {
            font-family: 'Fira Code', 'Consolas', monospace;
        }

        /* Phone Overlay 3D Animation */
        .phone-overlay {
            position: absolute;
            bottom: 20px;
            right: 20px;
            width: 280px;
            opacity: 0;
            transform: translateX(100px) translateY(20px) rotateY(-15deg) scale(0.8);
            transform-style: preserve-3d;
            perspective: 1000px;
            transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
            pointer-events: none;
            filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.3));
            z-index: 10;
        }

        .phone-overlay.show {
            opacity: 1;
            transform: translateX(0) translateY(0) rotateY(0deg) scale(1);
        }

        @media (max-width: 1024px) {
            .phone-overlay {
                width: 200px;
                bottom: 10px;
                right: 10px;
            }
        }

        @media (max-width: 640px) {
            .phone-overlay {
                width: 150px;
                bottom: 5px;
                right: 5px;
            }
        }
    </style>

    <script>
        // 3D Phone Overlay Animation - Sequential Playback
        const codeVideo = document.getElementById('code-video');
        const phoneOverlay = document.getElementById('phone-overlay');
        const phoneVideo = document.getElementById('phone-video');

        let phoneShown = false;

        // When code video reaches 7 seconds, show phone overlay
        codeVideo?.addEventListener('timeupdate', () => {
            if (codeVideo.currentTime >= 7 && !phoneShown) {
                phoneOverlay?.classList.add('show');
                phoneVideo?.play();
                phoneShown = true;
            }
        });

        // When code video ends, pause it on the last frame
        codeVideo?.addEventListener('ended', () => {
            codeVideo.pause();
        });

        // When phone video ends, reset everything and restart
        phoneVideo?.addEventListener('ended', () => {
            // Hide phone overlay
            phoneOverlay?.classList.remove('show');
            phoneVideo.pause();
            phoneVideo.currentTime = 0;

            // Reset code video and play again
            codeVideo.currentTime = 0;
            codeVideo.play();
            phoneShown = false;
        });
    </script>
