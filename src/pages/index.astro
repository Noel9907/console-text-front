---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>console.text() - Text yourself when code runs</title>
    <meta name="description" content="One line. Zero config. Just works. Get SMS alerts when your code runs. 30-second setup for developers." />

    <!-- Open Graph -->
    <meta property="og:title" content="console.text() - Text yourself when code runs" />
    <meta property="og:description" content="One line. Zero config. Just works. Get SMS alerts when your code runs." />
    <meta property="og:type" content="website" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body class="font-sans antialiased bg-white text-slate-900">

    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 bg-white/80 backdrop-blur-md border-b border-slate-200 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center">
                    <a href="/" class="text-2xl font-bold text-slate-900">
                        <span class="font-mono">console.text()</span>
                    </a>
                </div>
                <div class="hidden md:flex items-center space-x-8">
                    <a href="/docs" class="text-slate-600 hover:text-slate-900 transition-colors">Docs</a>
                    <a href="#pricing" class="text-slate-600 hover:text-slate-900 transition-colors">Pricing</a>
                    <a href="#use-cases" class="text-slate-600 hover:text-slate-900 transition-colors">Use Cases</a>
                    <a href="#try-now" class="px-6 py-2 bg-indigo-600 text-white rounded-lg font-semibold hover:bg-indigo-700 transition-colors">
                        Get Started
                    </a>
                </div>
                <!-- Mobile menu button -->
                <button id="mobile-menu-button" class="md:hidden p-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>
        <!-- Mobile menu -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200">
            <div class="px-2 pt-2 pb-3 space-y-1">
                <a href="/docs" class="block px-3 py-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100">Docs</a>
                <a href="#pricing" class="block px-3 py-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100">Pricing</a>
                <a href="#use-cases" class="block px-3 py-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100">Use Cases</a>
                <a href="#try-now" class="block px-3 py-2 rounded-md bg-indigo-600 text-white font-semibold hover:bg-indigo-700">Get Started</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="pt-24 pb-16 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
            <!-- Title and Subtitle -->
            <div class="text-center mb-12">
                <h1 class="text-5xl lg:text-6xl font-bold text-slate-900 leading-tight mb-4">
                    Text yourself when code runs
                </h1>
                <p class="text-xl text-slate-600">
                    One line. Zero config. Just works.
                </p>
            </div>

            <div class="grid lg:grid-cols-12 gap-8 items-start">
                <!-- Left: Small Code Block -->
                <div class="lg:col-span-5 space-y-6">
                    <!-- Code Block -->
                    <div class="bg-slate-900 rounded-xl p-6 font-mono text-sm overflow-x-auto">
                        <div class="text-slate-400">// 1. Install</div>
                        <div class="text-slate-500 mt-1">npm install @holler2660/console-text</div>
                        <div class="mt-4 text-slate-400">// 2. Setup (once)</div>
                        <div class="mt-1"><span class="text-purple-400">const</span> <span class="text-slate-200">{`{ init }`} = </span><span class="text-purple-400">require</span><span class="text-slate-200">(</span><span class="text-amber-300">"@holler2660/console-text"</span><span class="text-slate-200">);</span></div>
                        <div class="mt-1"><span class="text-slate-200">init({`{ apiKey: `}</span><span class="text-amber-300">"ct_live_..."</span><span class="text-slate-200"> {`}`});</span></div>
                        <div class="mt-4 text-slate-400">// 3. Use anywhere</div>
                        <div class="mt-1"><span class="text-slate-200">console.text(</span><span class="text-amber-300">"Payment processed!"</span><span class="text-slate-200">);</span></div>
                        <div class="text-slate-500 mt-2">// → SMS in 5-10 seconds ✓</div>
                    </div>

                    <!-- CTAs -->
                    <div class="flex flex-col gap-3">
                        <a href="#try-now" class="px-8 py-4 bg-indigo-600 text-white rounded-lg font-semibold hover:bg-indigo-700 transition-colors text-center shadow-lg shadow-indigo-600/30">
                            Start Free - 50 Messages
                        </a>
                        <button id="watch-demo-btn" class="px-8 py-4 bg-white border-2 border-indigo-600 text-indigo-600 rounded-lg font-semibold hover:bg-indigo-50 transition-colors">
                            Watch Demo
                        </button>
                    </div>

                    <!-- Trust Bar -->
                    <div class="flex flex-col gap-y-3 text-sm text-slate-600">
                        <div class="flex items-center gap-2">
                            <svg class="w-5 h-5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            Works globally (200+ countries)
                        </div>
                        <div class="flex items-center gap-2">
                            <svg class="w-5 h-5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            10-second setup
                        </div>
                        <div class="flex items-center gap-2">
                            <svg class="w-5 h-5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            Never crashes your app
                        </div>
                    </div>
                </div>

                <!-- Right: Video Demo Area -->
                <div class="lg:col-span-7 relative">
                    <!-- Code Video (Main) -->
                    <video
                        id="code-video"
                        autoplay
                        muted
                        playsinline
                        class="w-full rounded-xl shadow-2xl border border-slate-200"
                    >
                        <source src={`${import.meta.env.BASE_URL}/videos/code-demo.mp4`} type="video/mp4" />
                        Your browser does not support the video tag.
                    </video>

                    <!-- Phone Video (3D Overlay) - Hidden initially -->
                    <div id="phone-overlay" class="phone-overlay">
                        <video
                            id="phone-video"
                            muted
                            playsinline
                            class="w-full rounded-xl shadow-2xl"
                        >
                            <source src={`${import.meta.env.BASE_URL}/videos/phone-demo.mp4`} type="video/mp4" />
                            Your browser does not support the video tag.
                        </video>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Problem/Solution Section -->
    <section class="py-16 bg-slate-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl lg:text-4xl font-bold text-center mb-12">Stop anxiously checking dashboards</h2>

            <div class="grid md:grid-cols-3 gap-8">
                <!-- The Problem -->
                <div class="bg-white rounded-2xl p-8 border border-slate-200">
                    <h3 class="text-xl font-bold mb-4 text-slate-900">The Problem</h3>
                    <ul class="space-y-3">
                        <li class="flex items-start gap-3">
                            <span class="text-slate-600">❌  Deploy at 11pm</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-slate-600">❌  Refresh dashboards for an hour</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-slate-600">❌  Find out next morning it failed</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-slate-600">❌  Cost: real money, real users</span>
                        </li>
                    </ul>
                </div>

                <!-- Existing Solutions -->
                <div class="bg-white rounded-2xl p-8 border border-slate-200">
                    <h3 class="text-xl font-bold mb-4 text-slate-900">Existing Solutions</h3>
                    <ul class="space-y-3">
                        <li class="flex items-start gap-3">
                            <span class="text-slate-600">⚠️  Sentry/DataDog: 2 hours setup</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-slate-600">⚠️  PagerDuty: $$$, complex</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-slate-600">⚠️  Twilio: manage credentials, rate limits, retries</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-slate-600">⚠️  ntfy.sh: install app, configure topics</span>
                        </li>
                    </ul>
                </div>

                <!-- console.text() -->
                <div class="bg-gradient-to-br from-indigo-50 to-purple-50 rounded-2xl p-8 border-2 border-indigo-200 relative">
                    <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-indigo-600 text-white px-4 py-1 rounded-full text-sm font-semibold">
                        The Solution
                    </div>
                    <h3 class="text-xl font-bold mb-4 text-slate-900">console.text()</h3>
                    <ul class="space-y-3">
                        <li class="flex items-start gap-3">
                            <span class="text-slate-700 font-medium">✅  2 lines of code</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-slate-700 font-medium">✅  Works in 30 seconds</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-slate-700 font-medium">✅  No setup, no config</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-slate-700 font-medium">✅  Built-in rate limiting</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Interactive Demo Section -->
    <section id="try-now" class="py-16 px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
            <div class="text-center mb-12">
                <h2 class="text-3xl lg:text-4xl font-bold mb-4">Try it right now (no signup required)</h2>
                <p class="text-lg text-slate-600">Generate your API key and send a test SMS in 30 seconds</p>
            </div>

            <div class="bg-white rounded-2xl border-2 border-indigo-200 shadow-xl p-8">
                <div id="key-generation-form">
                    <h3 class="text-xl font-bold mb-6">Step 1: Generate Your API Key</h3>
                    <form id="generate-key-form" class="space-y-4">
                        <div>
                            <label for="email" class="block text-sm font-medium text-slate-700 mb-2">Email</label>
                            <input
                                type="email"
                                id="email"
                                required
                                class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                placeholder="you@example.com"
                            />
                        </div>
                        <div>
                            <label for="phone" class="block text-sm font-medium text-slate-700 mb-2">Phone Number (with country code)</label>
                            <input
                                type="tel"
                                id="phone"
                                required
                                pattern="^\+[1-9]\d{1,14}$"
                                class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                placeholder="+15551234567"
                            />
                            <p class="text-xs text-slate-500 mt-1">
                                <strong>Format:</strong> +CountryCode followed by number (e.g., +15551234567 for US, +447911123456 for UK)
                            </p>
                        </div>
                        <button
                            type="submit"
                            class="w-full px-6 py-4 bg-indigo-600 text-white rounded-lg font-semibold hover:bg-indigo-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                        >
                            Generate API Keys
                        </button>
                    </form>
                    <p class="text-sm text-slate-500 mt-4 text-center">
                        Free forever. No credit card required. 50 free messages to get started.
                    </p>
                </div>

                <div id="api-keys-display" class="hidden space-y-6">
                    <div>
                        <h3 class="text-xl font-bold mb-4 text-emerald-600">✅ API Keys Generated!</h3>
                        <div class="space-y-4">
                            <div class="bg-slate-50 rounded-lg p-4 border border-slate-200">
                                <div class="text-sm font-medium text-slate-600 mb-2">Test Key (logs only, no SMS)</div>
                                <div class="flex items-center gap-2">
                                    <code id="test-key" class="flex-1 font-mono text-sm bg-white px-3 py-2 rounded border border-slate-200">ct_test_***</code>
                                    <button onclick="copyToClipboard('test-key')" class="px-3 py-2 bg-slate-200 hover:bg-slate-300 rounded text-sm font-medium transition-colors">
                                        Copy
                                    </button>
                                </div>
                            </div>
                            <div class="bg-slate-50 rounded-lg p-4 border border-slate-200">
                                <div class="text-sm font-medium text-slate-600 mb-2">Live Key (sends real SMS)</div>
                                <div class="flex items-center gap-2">
                                    <code id="live-key" class="flex-1 font-mono text-sm bg-white px-3 py-2 rounded border border-slate-200">ct_live_***</code>
                                    <button onclick="copyToClipboard('live-key')" class="px-3 py-2 bg-slate-200 hover:bg-slate-300 rounded text-sm font-medium transition-colors">
                                        Copy
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 p-3 bg-amber-50 border border-amber-200 rounded-lg">
                            <p class="text-sm text-amber-800">
                                <strong>⚠️ Save these now!</strong> You won't see them again. Store them securely.
                            </p>
                        </div>
                    </div>

                    <div class="border-t border-slate-200 pt-6">
                        <h3 class="text-xl font-bold mb-4">Step 2: Send Your First Alert</h3>
                        <form id="send-sms-form" class="space-y-4">
                            <div>
                                <label for="message" class="block text-sm font-medium text-slate-700 mb-2">Message</label>
                                <input
                                    type="text"
                                    id="message"
                                    required
                                    maxlength="500"
                                    class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                    placeholder="Hello from console.text()!"
                                />
                            </div>
                            <button
                                type="submit"
                                class="w-full px-6 py-4 bg-emerald-600 text-white rounded-lg font-semibold hover:bg-emerald-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                            >
                                Send Test SMS
                            </button>
                        </form>
                        <div id="send-result" class="mt-4"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Value Proposition Table -->
    <section class="py-16 bg-slate-50 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
            <h2 class="text-3xl lg:text-4xl font-bold text-center mb-12">Why console.text()?</h2>

            <div class="overflow-x-auto">
                <table class="w-full bg-white rounded-2xl overflow-hidden shadow-lg">
                    <thead class="bg-slate-900 text-white">
                        <tr>
                            <th class="px-6 py-4 text-left font-semibold">Feature</th>
                            <th class="px-6 py-4 text-center font-semibold">Twilio</th>
                            <th class="px-6 py-4 text-center font-semibold">Sentry</th>
                            <th class="px-6 py-4 text-center font-semibold">PagerDuty</th>
                            <th class="px-6 py-4 text-center font-semibold bg-indigo-600">console.text()</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200">
                        <tr>
                            <td class="px-6 py-4 font-medium">Setup time</td>
                            <td class="px-6 py-4 text-center text-slate-600">2-4 hours</td>
                            <td class="px-6 py-4 text-center text-slate-600">1-2 hours</td>
                            <td class="px-6 py-4 text-center text-slate-600">2-3 hours</td>
                            <td class="px-6 py-4 text-center font-bold text-indigo-600 bg-indigo-50">30 seconds</td>
                        </tr>
                        <tr>
                            <td class="px-6 py-4 font-medium">Code required</td>
                            <td class="px-6 py-4 text-center text-slate-600">50+ lines</td>
                            <td class="px-6 py-4 text-center text-slate-600">20+ lines</td>
                            <td class="px-6 py-4 text-center text-slate-600">Config files</td>
                            <td class="px-6 py-4 text-center font-bold text-indigo-600 bg-indigo-50">1 line</td>
                        </tr>
                        <tr>
                            <td class="px-6 py-4 font-medium">Rate limiting</td>
                            <td class="px-6 py-4 text-center text-slate-600">Build it yourself</td>
                            <td class="px-6 py-4 text-center text-emerald-600">✓ Built-in</td>
                            <td class="px-6 py-4 text-center text-emerald-600">✓ Built-in</td>
                            <td class="px-6 py-4 text-center font-bold text-emerald-600 bg-indigo-50">✓ Built-in</td>
                        </tr>
                        <tr>
                            <td class="px-6 py-4 font-medium">Multi-channel</td>
                            <td class="px-6 py-4 text-center text-slate-600">Build each</td>
                            <td class="px-6 py-4 text-center text-slate-600">Errors only</td>
                            <td class="px-6 py-4 text-center text-slate-600">$$$ add-on</td>
                            <td class="px-6 py-4 text-center font-bold text-indigo-600 bg-indigo-50">Coming soon</td>
                        </tr>
                        <tr>
                            <td class="px-6 py-4 font-medium">Pricing</td>
                            <td class="px-6 py-4 text-center text-slate-600">Pay Twilio</td>
                            <td class="px-6 py-4 text-center text-slate-600">Free-$29/mo</td>
                            <td class="px-6 py-4 text-center text-slate-600">$19+/user</td>
                            <td class="px-6 py-4 text-center font-bold text-indigo-600 bg-indigo-50">Free-$10/mo</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Use Cases Section -->
    <section id="use-cases" class="py-16 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
            <h2 class="text-3xl lg:text-4xl font-bold text-center mb-4">Not just for errors</h2>
            <p class="text-lg text-slate-600 text-center mb-12">See how developers use console.text() in production</p>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Use Case 1 -->
                <div class="bg-white rounded-2xl p-6 border border-slate-200 hover:border-indigo-300 hover:shadow-lg transition-all">
                    <div class="text-4xl mb-4">💥</div>
                    <h3 class="text-xl font-bold mb-3">Production Errors</h3>
                    <ul class="space-y-2 text-slate-600 mb-4">
                        <li>• Payment processing errors</li>
                        <li>• Auth system failures</li>
                        <li>• Database connection issues</li>
                    </ul>
                    <div class="text-sm text-indigo-600 font-medium">Perfect for: Solo devs, startups</div>
                </div>

                <!-- Use Case 2 -->
                <div class="bg-white rounded-2xl p-6 border border-slate-200 hover:border-indigo-300 hover:shadow-lg transition-all">
                    <div class="text-4xl mb-4">🎯</div>
                    <h3 class="text-xl font-bold mb-3">Event Notifications</h3>
                    <ul class="space-y-2 text-slate-600 mb-4">
                        <li>• Course availability alerts</li>
                        <li>• Appointment slot openings</li>
                        <li>• Inventory back in stock</li>
                    </ul>
                    <div class="text-sm text-indigo-600 font-medium">Perfect for: Families, small teams</div>
                </div>

                <!-- Use Case 3 -->
                <div class="bg-white rounded-2xl p-6 border border-slate-200 hover:border-indigo-300 hover:shadow-lg transition-all">
                    <div class="text-4xl mb-4">🚀</div>
                    <h3 class="text-xl font-bold mb-3">Deployment Alerts</h3>
                    <ul class="space-y-2 text-slate-600 mb-4">
                        <li>• Deploy succeeded/failed</li>
                        <li>• Migration completed</li>
                        <li>• Build status updates</li>
                    </ul>
                    <div class="text-sm text-indigo-600 font-medium">Perfect for: CI/CD pipelines</div>
                </div>

                <!-- Use Case 4 -->
                <div class="bg-white rounded-2xl p-6 border border-slate-200 hover:border-indigo-300 hover:shadow-lg transition-all">
                    <div class="text-4xl mb-4">⏰</div>
                    <h3 class="text-xl font-bold mb-3">Cron Job Confirmations</h3>
                    <ul class="space-y-2 text-slate-600 mb-4">
                        <li>• Backup completed</li>
                        <li>• Report generated</li>
                        <li>• Data sync finished</li>
                    </ul>
                    <div class="text-sm text-indigo-600 font-medium">Perfect for: Background jobs</div>
                </div>

                <!-- Use Case 5 -->
                <div class="bg-white rounded-2xl p-6 border border-slate-200 hover:border-indigo-300 hover:shadow-lg transition-all">
                    <div class="text-4xl mb-4">🔗</div>
                    <h3 class="text-xl font-bold mb-3">Webhook Monitoring</h3>
                    <ul class="space-y-2 text-slate-600 mb-4">
                        <li>• Stripe webhook received</li>
                        <li>• GitHub webhook processed</li>
                        <li>• API callback confirmed</li>
                    </ul>
                    <div class="text-sm text-indigo-600 font-medium">Perfect for: Integrations</div>
                </div>

                <!-- Use Case 6 -->
                <div class="bg-white rounded-2xl p-6 border border-slate-200 hover:border-indigo-300 hover:shadow-lg transition-all">
                    <div class="text-4xl mb-4">📊</div>
