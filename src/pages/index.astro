    <!-- Video Modal -->
    <div id="video-modal" class="hidden fixed inset-0 bg-black/80 z-50 flex items-center justify-center p-4">
        <div class="relative max-w-5xl w-full">
            <button id="close-modal" class="absolute -top-12 right-0 text-white hover:text-slate-300 text-4xl">
                ×
            </button>
            <video
                id="modal-video"
                controls
                class="w-full rounded-xl"
            >
                <source src={`${import.meta.env.BASE_URL}/videos/demo.mp4`} type="video/mp4" />
            </video>
        </div>
