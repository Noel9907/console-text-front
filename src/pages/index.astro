    <script>
        // Mobile menu toggle
        const mobileMenuButton = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');

        mobileMenuButton?.addEventListener('click', () => {
            mobileMenu?.classList.toggle('hidden');
        });

        // Video modal
        const watchDemoBtn = document.getElementById('watch-demo-btn');
        const videoModal = document.getElementById('video-modal');
        const closeModal = document.getElementById('close-modal');
        const modalVideo = document.getElementById('modal-video');

        watchDemoBtn?.addEventListener('click', () => {
            videoModal?.classList.remove('hidden');
            modalVideo.play();
        });

        closeModal?.addEventListener('click', () => {
            videoModal?.classList.add('hidden');
            modalVideo.pause();
        });

        videoModal?.addEventListener('click', (e) => {
            if (e.target === videoModal) {
                videoModal.classList.add('hidden');
                modalVideo.pause();
            }
        });

        // Copy to clipboard
        window.copyToClipboard = function(elementId) {
            const element = document.getElementById(elementId);
            const text = element?.textContent || '';
            navigator.clipboard.writeText(text).then(() => {
                const button = element?.nextElementSibling;
                const originalText = button?.textContent;
                if (button) {
                    button.textContent = 'Copied!';
                    setTimeout(() => {
                        button.textContent = originalText;
                    }, 2000);
                }
            });
        };

        // API Key Generation
        const generateKeyForm = document.getElementById('generate-key-form');
        const keyGenerationForm = document.getElementById('key-generation-form');
        const apiKeysDisplay = document.getElementById('api-keys-display');
        const phoneInput = document.getElementById('phone');

        // Real-time phone validation
        phoneInput?.addEventListener('input', (e) => {
            const phone = e.target.value;
            const phoneRegex = /^\+[1-9]\d{1,14}$/;

            if (phone.length > 0 && !phoneRegex.test(phone)) {
                e.target.setCustomValidity('Phone must start with + followed by country code and number (e.g., +15551234567)');
            } else {
                e.target.setCustomValidity('');
            }
        });

        generateKeyForm?.addEventListener('submit', async (e) => {
            e.preventDefault();

            const email = document.getElementById('email').value;
            const phone = document.getElementById('phone').value;

            // Client-side validation
            const phoneRegex = /^\+[1-9]\d{1,14}$/;
            if (!phoneRegex.test(phone)) {
                alert('Invalid phone number format.\n\nPlease use E.164 format:\n+CountryCode followed by number\n\nExamples:\n+15551234567 (US)\n+447911123456 (UK)\n+917306761456 (India)');
                return;
            }

            const submitButton = e.target.querySelector('button[type="submit"]');
            submitButton.disabled = true;
            submitButton.textContent = 'Generating...';

            try {
                const apiUrl = 'https://api-production-298e.up.railway.app/v1/signup';

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        email,
                        phone
                    })
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    let errorMessage = errorData.message || 'Failed to generate API keys';

                    if (errorData.details) {
                        if (Array.isArray(errorData.details)) {
                            const errors = errorData.details.map(err => {
                                const field = err.path?.join('.') || 'field';
                                return `${field}: ${err.message}`;
                            }).join('\n');
                            errorMessage = `Validation errors:\n${errors}`;
                        } else if (typeof errorData.details === 'string') {
                            errorMessage = errorData.details;
                        }
                    }

                    throw new Error(errorMessage);
                }

                const data = await response.json();

                // Display API keys
                document.getElementById('test-key').textContent = data.apiKeys.test;
                document.getElementById('live-key').textContent = data.apiKeys.live;

                // Store live key for SMS sending
                sessionStorage.setItem('apiKey', data.apiKeys.live);

                // Hide form, show keys
                keyGenerationForm?.classList.add('hidden');
                apiKeysDisplay?.classList.remove('hidden');
            } catch (error) {
                const errorMsg = error.message || 'Error generating API keys. Please try again.';
                alert(errorMsg);
                console.error('Signup error:', error);
            } finally {
                submitButton.disabled = false;
                submitButton.textContent = 'Generate API Keys';
            }
        });

        // Send SMS
        const sendSmsForm = document.getElementById('send-sms-form');
        const sendResult = document.getElementById('send-result');

        sendSmsForm?.addEventListener('submit', async (e) => {
            e.preventDefault();

            const message = document.getElementById('message').value;
            const apiKey = sessionStorage.getItem('apiKey');

            if (!apiKey) {
                sendResult.innerHTML = '<div class="p-3 bg-red-50 border border-red-200 rounded-lg text-red-700">Please generate API keys first</div>';
                return;
            }

            const submitButton = e.target.querySelector('button[type="submit"]');
            submitButton.disabled = true;
            submitButton.textContent = 'Sending...';

            try {
                const apiUrl = 'https://api-production-298e.up.railway.app/v1/alert';

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify({
                        message,
                        metadata: {
                            source: 'website-demo'
                        }
                    })
                });

                if (!response.ok) {
                    throw new Error('Failed to send SMS');
                }

                sendResult.innerHTML = `
                    <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-lg">
                        <div class="flex items-start gap-3">
                            <svg class="w-6 h-6 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            <div>
                                <div class="font-semibold text-emerald-700 mb-1">Message sent!</div>
                                <div class="text-sm text-emerald-600">Check your phone in 5-10 seconds.</div>
                            </div>
                        </div>
                    </div>
                `;

                // Clear message input
                document.getElementById('message').value = '';
            } catch (error) {
                sendResult.innerHTML = '<div class="p-3 bg-red-50 border border-red-200 rounded-lg text-red-700">Error sending message. Please try again.</div>';
                console.error(error);
            } finally {
                submitButton.disabled = false;
                submitButton.textContent = 'Send Test SMS';
            }
        });

        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>

    <style>
